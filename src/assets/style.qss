/* ============================================================
   JK Catalog Multi — Design System QSS
   Palette: Teal Primary (#0B9B8A), Dark Navy (#1A2035)
   Font: Inter 13px base
   Aesthetic: Minimalist Corporate (Linear / Vercel inspired)
   ============================================================ */

/* --- 1. Global Setup --- */
QWidget {
    font-family: 'Inter', 'Segoe UI', sans-serif;
    font-size: 13px;
    color: #1A2035;
}

/* Force text contrast on Login/Launch widgets */
#CompanyListWidget, #LoginDialog, #PathDialog, #FormContent, #ListHeader, #ListHeaderTitle {
    color: #1A2035;
    background-color: transparent;
}

#CompanyListWidget::item {
    color: #1A2035;
    padding: 6px 10px;
}
#CompanyListWidget::item:selected {
    background-color: #0B9B8A;
    color: white;
}

/* --- 2. Sidebar (Light Corporate) --- */
#MainSidebar {
    background-color: #F4F5F7;
    border-right: 1px solid #E2E4E8;
}

/* Content Area */
#ContentArea {
    background-color: #FAFBFC;
}

/* Sidebar labels — dark text on light background */
#MainSidebar QLabel {
    color: #1A2035;
}

#QuitHint {
    color: #6B7280;
    font-size: 11px;
    qproperty-alignment: 'AlignCenter';
    margin-top: 10px;
}

/* --- 3. Menu Buttons (Sidebar Nav Items) --- */
.MenuButton, #MenuButton {
    text-align: left;
    background-color: transparent;
    color: #4A5568;
    font-size: 13px;
    font-weight: 500;
    padding: 10px 16px;
    border-radius: 6px;
    margin: 2px 8px;
    border: none;
}

.MenuButton:hover, #MenuButton:hover {
    background-color: #EBF5F5;
    color: #0B9B8A;
    font-weight: 600;
}

/* Back button — stays red as user requested */
#MenuBackButton {
    color: #e74c3c;
    font-weight: bold;
    border-bottom: 1px solid #E2E4E8;
    margin-bottom: 8px;
}

.MenuButton[active="true"], #MenuButton[active="true"] {
    background-color: #EBF5F5;
    color: #0B9B8A;
    border-left: 3px solid #0B9B8A;
    font-weight: 600;
}

/* --- 4. Buttons --- */
QPushButton {
    background-color: #0B9B8A;
    color: white;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
    font-size: 13px;
    border: none;
}

QPushButton:hover {
    background-color: #0AAE9B;
}

QPushButton:pressed {
    background-color: #088273;
}

QPushButton:disabled {
    background-color: #D1D5DB;
    color: #9CA3AF;
}

/* --- 5. Inputs & Search --- */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
    padding: 6px 10px;
    border-radius: 6px;
    color: #1A2035;
    selection-background-color: #0B9B8A;
    selection-color: white;
}

QLineEdit:focus {
    border: 1px solid #0B9B8A;
    background-color: #FAFBFC;
}

QLineEdit::placeholder {
    color: #9CA3AF;
}

/* Inline cell editors — minimal padding for compact rows */
QTableWidget QLineEdit {
    padding: 1px 4px;
    border: 1px solid #0B9B8A;
    border-radius: 0px;
    margin: 0px;
}

/* --- 6. Data Tables --- */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #E2E4E8;
    border: 1px solid #E2E4E8;
    selection-background-color: #EBF5F5;
    selection-color: #1A2035;
    alternate-background-color: #F9FAFB;
    font-size: 13px;
}

QHeaderView::section {
    background-color: #1A2035;
    color: #ffffff;
    font-weight: 600;
    font-size: 12px;
    height: 34px;
    padding-left: 12px;
    border: 1px solid #111827;
}

/* Module-specific header accents (functional colors stay) */
#PaymentSheetTable QHeaderView::section, #SalesExcelTable QHeaderView::section {
    background-color: #1A2035;
}

#CostingTable QHeaderView::section {
    background-color: #1A2035;
}

/* --- 7. Tabs --- */
QTabWidget::pane {
    border: 1px solid #E2E4E8;
    background-color: white;
    top: -1px;
}

QTabBar::tab {
    background: #F4F5F7;
    color: #6B7280;
    padding: 10px 28px;
    border: 1px solid #E2E4E8;
    border-bottom: none;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 500;
    font-size: 13px;
}

QTabBar::tab:hover {
    background-color: #EBF5F5;
    color: #0B9B8A;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1A2035;
    font-weight: 600;
    border-top: 3px solid #0B9B8A;
}

QTabBar::tab:disabled {
    color: #D1D5DB;
    background-color: #F9FAFB;
}

/* Module-Specific Tab Accents — Payment keeps orange, Vat keeps teal */
#PaymentTabContainer QTabBar::tab:selected { border-top: 3px solid #e67e22; color: #e67e22; }
#VatTabWidget QTabBar::tab:selected { border-top: 3px solid #0B9B8A; color: #0B9B8A; }
#BalanceMain #VatTabWidget QTabBar::tab:selected { border-top: 3px solid #8e44ad; color: #8e44ad; }
#StockMain #VatTabWidget QTabBar::tab:selected { border-top: 3px solid #0B9B8A; color: #0B9B8A; }

/* --- 8. Add (+) Buttons --- */
#AddNewSheetBtn, #SalesAddSheetBtn, #VatAddBtn, #AddSheetButton {
    background-color: #1A2035;
    color: white;
    font-size: 22px;
    font-weight: bold;
    border-radius: 8px;
    min-width: 40px;
    margin: 4px;
    border: none;
}

#AddNewSheetBtn:hover, #SalesAddSheetBtn:hover { background-color: #0B9B8A; }
#VatAddBtn:hover { background-color: #0B9B8A; }

/* --- 9. Welcome Dashboard --- */
#WelcomePage {
    background-color: #FAFBFC;
}

#WelcomeCard {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
    border-radius: 12px;
}

#WelcomeSubtitle {
    font-size: 16px;
    color: #6B7280;
    font-weight: 400;
}

#WelcomeTitle {
    font-size: 36px;
    font-weight: 800;
    color: #1A2035;
    letter-spacing: -0.02em;
}

#WelcomeTagline {
    font-size: 13px;
    color: #6B7280;
    margin-top: 6px;
}

#StatCard {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
    border-radius: 10px;
    min-height: 80px;
}

#StatIcon {
    font-size: 22px;
    background: transparent;
}

#StatValue {
    font-size: 18px;
    font-weight: 700;
    color: #1A2035;
    background: transparent;
}

#StatLabel {
    font-size: 12px;
    color: #6B7280;
    font-weight: 500;
    background: transparent;
}

#TipsCard {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
    border-radius: 10px;
}

#TipsTitle {
    font-size: 15px;
    font-weight: 600;
    color: #1A2035;
}

#TipItem {
    font-size: 13px;
    color: #4A5568;
    padding: 2px 0;
}

/* --- 10. Misc Elements --- */
#StatusLabel {
    color: #0B9B8A;
    background-color: #EBF5F5;
    border: 1px solid #0B9B8A;
    padding: 6px 10px;
    border-radius: 6px;
    font-weight: 600;
}

/* --- 11. Payment List --- */
#PaymentListLabel {
    font-size: 20px;
    font-weight: 600;
}

/* --- 12. Settings / User Manager --- */
#UserManagerDialog {
    background-color: #FAFBFC;
    border: 1px solid #E2E4E8;
}

#UserDialogTitle {
    font-size: 20px;
    font-weight: 700;
    text-decoration: none;
    color: #1A2035;
}

/* --- 13. Cheque List --- */
#BtnClearCheque {
    background-color: #0B9B8A;
    color: white;
    font-weight: 600;
}
#BtnPrintCheque, #BtnBankList, #BtnExportCheque {
    background-color: #1A2035;
    color: white;
}
#LblChequeCount, #LblChequeTotal {
    font-weight: 600;
    margin-right: 10px;
}

/* --- 14. Catalog UI (Print-specific — white stays) --- */
#CatalogPage {
    background-color: white;
    border: none;
}
#CatalogHeader {
    border: 1px solid #1A2035;
}
#CatalogFooter {
    border-bottom: 1px solid #1A2035;
    border-left: 1px solid #1A2035;
    border-right: 1px solid #1A2035;
}
#CatalogContentArea {
    border: none;
    background-color: white;
}
*[cssClass="CatalogMetaLabel"] {
    border: none;
    font-family: "Arial";
    font-size: 9px;
}

/* --- 15. Vat Pages (Theme Based) --- */
/* Balance (Purple) */
#BalanceMain #VatAddBtn {
    background-color: #8e44ad;
    color: white;
    font-weight: 600;
    margin-right: 12px;
    border-radius: 6px;
}
#BalanceMain QTableWidget QHeaderView::section {
    background-color: #8e44ad;
    color: white;
    font-weight: 600;
    height: 30px;
    border: 1px solid #E2E4E8;
}

/* Stock (Teal) */
#StockMain #VatAddBtn {
    background-color: #0B9B8A;
    color: white;
    font-weight: 600;
    margin-right: 12px;
    border-radius: 6px;
}
#StockMain #VatTabWidget QTabBar::tab:selected {
    border-top: 3px solid #0B9B8A;
    font-weight: 600;
    background: white;
}
#StockMain QTableWidget QHeaderView::section {
    background-color: #0B9B8A;
    color: white;
    font-weight: 600;
    height: 30px;
    border: 1px solid #E2E4E8;
}

/* --- 16. Super Master --- */
#SuperMasterMain {
    background-color: #FAFBFC;
}

#FilterBar QLineEdit {
    border: 1px solid #E2E4E8;
    border-radius: 0px;
    background-color: #ffffff;
    font-size: 13px;
    margin-right: 2px;
}
#FilterBar QLineEdit:focus {
    border: 1px solid #0B9B8A;
    background-color: #ffffff;
    border-bottom: 2px solid #0B9B8A;
}

#DetailedMappingTable {
    border: 1px solid #E2E4E8;
    alternate-background-color: #F9FAFB;
}
#DetailedMappingTable::item {
    padding: 2px 4px;
}

#SummaryTable {
    border: 1px solid #E2E4E8;
    background-color: #ffffff;
}

/* --- 17. Report Action Dialog --- */
#ReportActionDialog {
    background-color: #ffffff;
}
#ReportActionDialog QLabel {
    font-size: 13px;
    font-weight: 500;
}
#ReportActionDialog #CrmSelector {
    padding: 6px;
    border: 1px solid #E2E4E8;
    border-radius: 6px;
}
#ReportActionDialog #PendingPagesList {
    border: 1px solid #E2E4E8;
    background-color: #FAFBFC;
    border-radius: 6px;
}
#ReportActionDialog #PrimaryActionButton {
    background-color: #0B9B8A;
    color: white;
    font-weight: 600;
    font-size: 13px;
    border-radius: 8px;
    padding: 8px 16px;
}
#ReportActionDialog #PrimaryActionButton:hover {
    background-color: #0AAE9B;
}
#ReportActionDialog #SecondaryButton {
    background-color: #F4F5F7;
    color: #4A5568;
    font-weight: 600;
    border-radius: 8px;
    padding: 8px 16px;
    border: 1px solid #E2E4E8;
}
#ReportActionDialog #SecondaryButton:hover {
    background-color: #E2E4E8;
}

/* --- 18. Security UI --- */
#SecurityUI {
    background-color: #FAFBFC;
}

#SecurityTitle {
    color: #1A2035;
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
}

#SecurityDetailsFrame {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 8px;
}

#SecurityDetailsFrame QLabel {
    font-size: 13px;
    font-weight: 500;
    color: #4A5568;
}

#SecurityDetailsFrame QComboBox {
    padding: 6px;
    border: 1px solid #E2E4E8;
    border-radius: 6px;
    background: #fff;
    min-width: 150px;
    font-size: 13px;
}

#SecurityNewBtn {
    background-color: #0B9B8A;
    color: white;
    font-weight: 600;
    border-radius: 6px;
    padding: 6px 12px;
}
#SecurityNewBtn:hover {
    background-color: #0AAE9B;
}

#SecurityDelBtn {
    background-color: #e74c3c;
    color: white;
    font-weight: 600;
    border-radius: 6px;
    padding: 6px 12px;
}
#SecurityDelBtn:hover {
    background-color: #c0392b;
}

#GranularAccessTable {
    background-color: #FAFBFC;
    border: none;
    font-size: 13px;
}

#GranularAccessTable::item {
    padding: 6px 10px;
    border: none;
    border-bottom: 1px solid #E2E4E8;
}

#GranularAccessTable::item:hover {
    background-color: #EBF5F5;
}

#GranularAccessTable QComboBox {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 13px;
    font-weight: 600;
    color: #1A2035;
    min-height: 24px;
}

#GranularAccessTable QComboBox:hover {
    border: 1px solid #0B9B8A;
    background-color: #FAFBFC;
}

#GranularAccessTable QComboBox:focus {
    border: 2px solid #0B9B8A;
    background-color: #EBF5F5;
}

#GranularAccessTable QComboBox::drop-down {
    border: none;
    width: 20px;
    subcontrol-position: right center;
}

#GranularAccessTable QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

/* --- 19. Primary / Secondary Action Buttons --- */
#PrimaryActionButton {
    background-color: #0B9B8A;
    color: white;
    font-weight: 600;
    border-radius: 8px;
    padding: 8px 16px;
}
#PrimaryActionButton:hover {
    background-color: #0AAE9B;
}

#SecondaryButton {
    background-color: #F4F5F7;
    color: #4A5568;
    font-weight: 600;
    border-radius: 8px;
    padding: 8px 16px;
    border: 1px solid #E2E4E8;
}
#SecondaryButton:hover {
    background-color: #E2E4E8;
}

/* --- 20. CRM & Dialog Polish --- */
#CRMManagerDialog {
    background-color: #FAFBFC;
}
#CRMManagerDialog QLabel {
    font-size: 13px;
    color: #1A2035;
}

/* --- 21. Login Dialog --- */
#LoginHeader {
    background-color: #1A2035;
}
#LoginTitle {
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
}
#LoginContent {
    background-color: #ffffff;
}
#LoginLabel {
    color: #4A5568;
    font-size: 13px;
    font-weight: 500;
}
#LoginInput {
    border: 1px solid #E2E4E8;
    border-radius: 6px;
    padding: 8px;
    font-size: 13px;
    background-color: #ffffff;
    color: #1A2035;
}
#LoginInput:focus {
    border: 1px solid #0B9B8A;
    background-color: #FAFBFC;
}
#LoginErrorLabel {
    color: #e74c3c;
    font-size: 12px;
    font-weight: 500;
}

/* --- 22. Scrollbars --- */
QScrollBar:vertical {
    background: #F4F5F7;
    width: 10px;
    border: none;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #D1D5DB;
    min-height: 30px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #9CA3AF;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #F4F5F7;
    height: 10px;
    border: none;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background: #D1D5DB;
    min-width: 30px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background: #9CA3AF;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* --- 23. Tooltips --- */
QToolTip {
    background-color: #1A2035;
    color: #ffffff;
    border: none;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
}

/* --- 24. ComboBox (Global) --- */
QComboBox {
    border: 1px solid #E2E4E8;
    border-radius: 6px;
    padding: 5px 10px;
    background: #ffffff;
    color: #1A2035;
    font-size: 13px;
}
QComboBox:hover {
    border: 1px solid #0B9B8A;
}
QComboBox:focus {
    border: 1px solid #0B9B8A;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
    selection-background-color: #EBF5F5;
    selection-color: #1A2035;
    padding: 4px;
}

/* --- 25. Progress Bar --- */
QProgressBar {
    border: 1px solid #E2E4E8;
    border-radius: 6px;
    background-color: #F4F5F7;
    text-align: center;
    font-size: 12px;
    color: #1A2035;
    height: 20px;
}
QProgressBar::chunk {
    background-color: #0B9B8A;
    border-radius: 5px;
}
