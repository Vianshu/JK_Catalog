/* ============================================================
   JK Catalog Multi — Design System QSS
   Palette: Teal Primary (#0B9B8A), Dark Navy (#1A2035)
   Font: Inter 13px base
   Aesthetic: Minimalist Corporate (Linear / Vercel inspired)
   ============================================================ */

/* --- 1. Global Setup --- */
QWidget {
    font-family: 'Inter', 'Segoe UI', sans-serif;
    font-size: 13px;
    color: #1A2035;
}

/* Force text contrast on Login/Launch widgets */
#CompanyListWidget, #LoginDialog, #PathDialog, #FormContent, #ListHeader, #ListHeaderTitle {
    color: #1A2035;
    background-color: transparent;
}

/* Company Selection Screen — List */
#CompanyListWidget {
    font-size: 15px;
    border: none;
    outline: none;
}
#CompanyListWidget::item {
    color: #1A2035;
    padding: 8px 14px;
    font-size: 15px;
}
#CompanyListWidget::item:selected {
    background-color: #0B9B8A;
    color: white;
}
#CompanyListWidget::item:hover {
    background-color: #EBF5F5;
}

/* Company Selection — Header */
#ListHeader {
    background-color: transparent;
    padding: 4px 0px;
}
#ListHeaderTitle {
    font-size: 20px;
    font-weight: 700;
    color: #1A2035;
    padding: 6px 10px;
}

/* Login Dialog */
#LoginDialog {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
}
#LoginHeader {
    background-color: #1A2035;
}
#LoginTitle {
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
}
#LoginCloseBtn {
    background: transparent;
    color: #ffffff;
    border: none;
    font-size: 16px;
    font-weight: bold;
}
#LoginCloseBtn:hover {
    color: #e74c3c;
    background-color: rgba(255,255,255,0.1);
    border-radius: 4px;
}
#LoginContent {
    background-color: #ffffff;
}
#LoginLabel {
    font-size: 13px;
    font-weight: 600;
    color: #1A2035;
}
#LoginInput {
    padding: 10px 12px;
    font-size: 13px;
    border: 1px solid #E2E4E8;
    border-radius: 6px;
    background-color: #FAFBFC;
    color: #1A2035;
}
#LoginInput:focus {
    border: 2px solid #0B9B8A;
    background-color: #ffffff;
}
#LoginErrorLabel {
    color: #e74c3c;
    font-weight: bold;
    font-size: 12px;
    padding: 2px 10px;
}
#LoginActionButton {
    background-color: #0B9B8A;
    color: white;
    font-size: 15px;
    font-weight: 700;
    border: none;
    border-radius: 0px;
    padding: 14px;
    margin: 0px;
    min-height: 20px;
}
#LoginActionButton:hover {
    background-color: #099179;
}

/* --- 2. Sidebar (Solid Teal) --- */
#MainSidebar {
    background-color: #0B9B8A;
    border-right: none;
}

/* Content Area */
#ContentArea {
    background-color: #EFF1F5;
}

/* Sidebar labels */
#MainSidebar QLabel {
    color: #ffffff;
}

/* CRITICAL: Override global QPushButton teal for ALL sidebar buttons */
#MainSidebar QPushButton {
    background-color: transparent;
    color: #ffffff;
    border: none;
    text-align: left;
    font-weight: 500;
    font-size: 14px;
    padding: 10px 16px;
    border-radius: 6px;
    margin: 2px 8px;
}
#MainSidebar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    font-weight: 600;
}

/* Company name button at top of sidebar */
QPushButton#CompanyDisplayBtn {
    background-color: transparent;
    color: #ffffff;
    font-weight: 700;
    font-size: 14px;
    text-align: left;
    padding: 10px 8px;
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.2);
    margin-bottom: 2px;
    border-radius: 0px;
}
QPushButton#CompanyDisplayBtn:hover {
    color: #ffffff;
    background-color: rgba(255,255,255,0.1);
}

/* Logged-in user badge shown below the company button */
#LoggedUserLabel {
    color: rgba(255,255,255,0.85);
    font-size: 11px;
    background-color: rgba(255,255,255,0.08);
    border-radius: 6px;
    padding: 4px 6px;
    margin: 2px 4px 6px 4px;
    qproperty-alignment: 'AlignCenter';
}

#QuitHint {
    color: rgba(255,255,255,0.5);
    font-size: 11px;
    qproperty-alignment: 'AlignCenter';
    margin-top: 10px;
}

/* --- 3. Menu Buttons (Sidebar Nav Items) --- */
.MenuButton, #MenuButton {
    text-align: left;
    background-color: transparent;
    color: #ffffff;
    font-size: 15px;
    font-weight: 500;
    padding: 10px 16px;
    border-radius: 6px;
    margin: 2px 6px;
    border: none;
}

.MenuButton:hover, #MenuButton:hover {
    background-color: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    font-weight: 600;
}

/* Back button */
#MenuBackButton {
    color: #ffffff;
    font-weight: bold;
    border-bottom: 1px solid rgba(255,255,255,0.2);
    margin-bottom: 8px;
}

.MenuButton[active="true"], #MenuButton[active="true"] {
    background-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    border-left: 3px solid #ffffff;
    font-weight: 600;
}

/* MenuButtonWidget — custom QFrame menu items */
#MenuButtonWidget {
    background: transparent;
    border-radius: 6px;
    margin: 1px 4px;
    border-left: 3px solid transparent;
}
#MenuButtonWidget:hover {
    background-color: rgba(255, 255, 255, 0.15);
}
#MenuButtonWidget[active="true"] {
    background-color: rgba(255, 255, 255, 0.2);
    border-left: 3px solid #ffffff;
    border-radius: 4px;
}
#MenuButtonWidget:disabled {
    background: transparent;
}
#MenuButtonWidget QLabel, #MenuLabel {
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    background: transparent;
    border: none;
}
#MenuButtonWidget:hover QLabel {
    color: #ffffff;
    font-weight: 700;
}
#MenuButtonWidget[active="true"] QLabel {
    color: #ffffff;
    font-weight: 700;
}
#MenuButtonWidget:disabled QLabel {
    color: rgba(255,255,255,0.35);
}

/* Logout Button — white outline on teal sidebar */
QPushButton#LogoutBtn {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 6px;
    font-weight: bold;
    font-size: 13px;
    padding: 8px;
    margin-top: 10px;
    margin-left: 6px;
    margin-right: 6px;
}
QPushButton#LogoutBtn:hover {
    background-color: #e74c3c;
    color: white;
    border: 1px solid #e74c3c;
}

/* --- 4. Buttons --- */
QPushButton {
    background-color: #0B9B8A;
    color: white;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
    font-size: 13px;
    border: none;
}

QPushButton:hover {
    background-color: #0AAE9B;
}

QPushButton:pressed {
    background-color: #088273;
}

QPushButton:disabled {
    background-color: #D1D5DB;
    color: #9CA3AF;
}

/* --- 5. Inputs & Search --- */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
    padding: 6px 10px;
    border-radius: 6px;
    color: #1A2035;
    selection-background-color: #0B9B8A;
    selection-color: white;
}

QLineEdit:focus {
    border: 1px solid #0B9B8A;
    background-color: #EFF1F5;
}

QLineEdit::placeholder {
    color: #9CA3AF;
}

/* Inline cell editors — minimal padding for compact rows */
QTableWidget QLineEdit {
    padding: 1px 4px;
    border: 1px solid #0B9B8A;
    border-radius: 0px;
    margin: 0px;
}

/* --- 6. Data Tables --- */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #E2E4E8;
    border: 1px solid #E2E4E8;
    selection-background-color: #EBF5F5;
    selection-color: #1A2035;
    alternate-background-color: #F9FAFB;
    font-size: 13px;
}

QHeaderView::section {
    background-color: #1A2035;
    color: #ffffff;
    font-weight: 600;
    font-size: 12px;
    height: 34px;
    padding-left: 12px;
    border: 1px solid #111827;
}

/* Module-specific header accents (functional colors stay) */
#PaymentSheetTable QHeaderView::section, #SalesExcelTable QHeaderView::section {
    background-color: #1A2035;
}

#CostingTable QHeaderView::section {
    background-color: #1A2035;
}

/* --- 7. Tabs --- */
QTabWidget::pane {
    border: 1px solid #E2E4E8;
    background-color: white;
    top: -1px;
}

QTabBar::tab {
    background: #F4F5F7;
    color: #4A5568;
    padding: 10px 28px;
    border: 1px solid #E2E4E8;
    border-bottom: none;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 500;
    font-size: 13px;
}

QTabBar::tab:hover {
    background-color: #EBF5F5;
    color: #0B9B8A;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1A2035;
    font-weight: 600;
    border-top: 3px solid #0B9B8A;
}

QTabBar::tab:disabled {
    color: #D1D5DB;
    background-color: #F9FAFB;
}

/* Module-Specific Tab Accents — Payment keeps orange, Vat keeps teal */
#PaymentTabContainer QTabBar::tab:selected { border-top: 3px solid #e67e22; color: #e67e22; }
#VatTabWidget QTabBar::tab:selected { border-top: 3px solid #0B9B8A; color: #0B9B8A; }
#BalanceMain #VatTabWidget QTabBar::tab:selected { border-top: 3px solid #8e44ad; color: #8e44ad; }
#StockMain #VatTabWidget QTabBar::tab:selected { border-top: 3px solid #0B9B8A; color: #0B9B8A; }

/* --- 8. Add (+) Buttons --- */
#AddNewSheetBtn, #SalesAddSheetBtn, #VatAddBtn, #AddSheetButton {
    background-color: #1A2035;
    color: white;
    font-size: 22px;
    font-weight: bold;
    border-radius: 8px;
    min-width: 40px;
    margin: 4px;
    border: none;
}

#AddNewSheetBtn:hover, #SalesAddSheetBtn:hover { background-color: #0B9B8A; }
#VatAddBtn:hover { background-color: #0B9B8A; }

/* --- 9. Welcome Dashboard --- */
#WelcomePage {
    background-color: #EFF1F5;
}

#WelcomeCard {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
    border-radius: 12px;
}

#WelcomeSubtitle {
    font-size: 16px;
    color: #6B7280;
    font-weight: 400;
}

#WelcomeTitle {
    font-size: 36px;
    font-weight: 800;
    color: #1A2035;
    letter-spacing: -0.02em;
}

#WelcomeTagline {
    font-size: 13px;
    color: #6B7280;
    margin-top: 6px;
}

#StatCard {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
    border-radius: 10px;
    min-height: 80px;
}

#StatIcon {
    font-size: 22px;
    background: transparent;
}

#StatValue {
    font-size: 18px;
    font-weight: 700;
    color: #1A2035;
    background: transparent;
}

#StatLabel {
    font-size: 12px;
    color: #6B7280;
    font-weight: 500;
    background: transparent;
}

#TipsCard {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
    border-radius: 10px;
}

#TipsTitle {
    font-size: 15px;
    font-weight: 600;
    color: #1A2035;
}

#TipItem {
    font-size: 13px;
    color: #4A5568;
    padding: 2px 0;
}

/* --- 10. Misc Elements --- */
#StatusLabel {
    color: #0B9B8A;
    background-color: #EBF5F5;
    border: 1px solid #0B9B8A;
    padding: 6px 10px;
    border-radius: 6px;
    font-weight: 600;
}

/* --- 11. Payment List --- */
#PaymentListLabel {
    font-size: 20px;
    font-weight: 600;
}

/* --- 12. Settings / User Manager --- */
#UserManagerDialog {
    background-color: #EFF1F5;
    border: 1px solid #E2E4E8;
}

#UserDialogTitle {
    font-size: 20px;
    font-weight: 700;
    text-decoration: none;
    color: #1A2035;
}

/* --- 13. Cheque List --- */
#BtnClearCheque {
    background-color: #0B9B8A;
    color: white;
    font-weight: 600;
}
#BtnPrintCheque, #BtnBankList, #BtnExportCheque {
    background-color: #1A2035;
    color: white;
}
#LblChequeCount, #LblChequeTotal {
    font-weight: 600;
    margin-right: 10px;
}

/* --- 14. Catalog UI (Print-specific — white stays) --- */
#CatalogPage {
    background-color: white;
    border: none;
}
#CatalogHeader {
    border: 1px solid #1A2035;
}
#CatalogFooter {
    border-bottom: 1px solid #1A2035;
    border-left: 1px solid #1A2035;
    border-right: 1px solid #1A2035;
}
#CatalogContentArea {
    border: none;
    background-color: white;
}
*[cssClass="CatalogMetaLabel"] {
    border: none;
    font-family: "Arial";
    font-size: 9px;
}

/* --- 15. Vat Pages (Theme Based) --- */
/* Balance (Purple) */
#BalanceMain #VatAddBtn {
    background-color: #8e44ad;
    color: white;
    font-weight: 600;
    margin-right: 12px;
    border-radius: 6px;
}
#BalanceMain QTableWidget QHeaderView::section {
    background-color: #8e44ad;
    color: white;
    font-weight: 600;
    height: 30px;
    border: 1px solid #E2E4E8;
}

/* Stock (Teal) */
#StockMain #VatAddBtn {
    background-color: #0B9B8A;
    color: white;
    font-weight: 600;
    margin-right: 12px;
    border-radius: 6px;
}
#StockMain #VatTabWidget QTabBar::tab:selected {
    border-top: 3px solid #0B9B8A;
    font-weight: 600;
    background: white;
}
#StockMain QTableWidget QHeaderView::section {
    background-color: #0B9B8A;
    color: white;
    font-weight: 600;
    height: 30px;
    border: 1px solid #E2E4E8;
}

/* --- 16. Super Master --- */
#SuperMasterMain {
    background-color: #EFF1F5;
}

#FilterBar QLineEdit {
    border: 1px solid #E2E4E8;
    border-radius: 0px;
    background-color: #ffffff;
    font-size: 13px;
    margin-right: 2px;
}
#FilterBar QLineEdit:focus {
    border: 1px solid #0B9B8A;
    background-color: #ffffff;
    border-bottom: 2px solid #0B9B8A;
}

#DetailedMappingTable {
    border: 1px solid #E2E4E8;
    alternate-background-color: #F9FAFB;
}
#DetailedMappingTable::item {
    padding: 2px 4px;
}

#SummaryTable {
    border: 1px solid #E2E4E8;
    background-color: #ffffff;
}

/* --- 17. Report Action Dialog --- */
#ReportActionDialog {
    background-color: #ffffff;
}
#ReportActionDialog QLabel {
    font-size: 13px;
    font-weight: 500;
}
#ReportActionDialog #CrmSelector {
    padding: 6px;
    border: 1px solid #E2E4E8;
    border-radius: 6px;
}
#ReportActionDialog #PendingPagesList {
    border: 1px solid #E2E4E8;
    background-color: #EFF1F5;
    border-radius: 6px;
}
#ReportActionDialog #PrimaryActionButton {
    background-color: #0B9B8A;
    color: white;
    font-weight: 600;
    font-size: 13px;
    border-radius: 8px;
    padding: 8px 16px;
}
#ReportActionDialog #PrimaryActionButton:hover {
    background-color: #0AAE9B;
}
#ReportActionDialog #SecondaryButton {
    background-color: #F4F5F7;
    color: #4A5568;
    font-weight: 600;
    border-radius: 8px;
    padding: 8px 16px;
    border: 1px solid #E2E4E8;
}
#ReportActionDialog #SecondaryButton:hover {
    background-color: #E2E4E8;
}

/* --- 18. Security UI --- */
#SecurityUI {
    background-color: #EFF1F5;
}

#SecurityTitle {
    color: #1A2035;
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
}

#SecurityDetailsFrame {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 8px;
}

#SecurityDetailsFrame QLabel {
    font-size: 13px;
    font-weight: 500;
    color: #4A5568;
}

#SecurityDetailsFrame QComboBox {
    padding: 6px;
    border: 1px solid #E2E4E8;
    border-radius: 6px;
    background: #fff;
    min-width: 150px;
    font-size: 13px;
}

#SecurityNewBtn {
    background-color: #0B9B8A;
    color: white;
    font-weight: 600;
    border-radius: 6px;
    padding: 6px 12px;
}
#SecurityNewBtn:hover {
    background-color: #0AAE9B;
}

#SecurityDelBtn {
    background-color: #e74c3c;
    color: white;
    font-weight: 600;
    border-radius: 6px;
    padding: 6px 12px;
}
#SecurityDelBtn:hover {
    background-color: #c0392b;
}

#GranularAccessTable {
    background-color: #EFF1F5;
    border: none;
    font-size: 13px;
}

#GranularAccessTable::item {
    padding: 6px 10px;
    border: none;
    border-bottom: 1px solid #E2E4E8;
}

#GranularAccessTable::item:hover {
    background-color: #EBF5F5;
}

#GranularAccessTable QComboBox {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 13px;
    font-weight: 600;
    color: #1A2035;
    min-height: 24px;
}

#GranularAccessTable QComboBox:hover {
    border: 1px solid #0B9B8A;
    background-color: #EFF1F5;
}

#GranularAccessTable QComboBox:focus {
    border: 2px solid #0B9B8A;
    background-color: #EBF5F5;
}

#GranularAccessTable QComboBox::drop-down {
    border: none;
    width: 20px;
    subcontrol-position: right center;
}

#GranularAccessTable QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

/* --- 19. Primary / Secondary Action Buttons --- */
#PrimaryActionButton {
    background-color: #0B9B8A;
    color: white;
    font-weight: 600;
    border-radius: 8px;
    padding: 8px 16px;
}
#PrimaryActionButton:hover {
    background-color: #0AAE9B;
}

#SecondaryButton {
    background-color: #F4F5F7;
    color: #4A5568;
    font-weight: 600;
    border-radius: 8px;
    padding: 8px 16px;
    border: 1px solid #E2E4E8;
}
#SecondaryButton:hover {
    background-color: #E2E4E8;
}

/* --- 20. CRM & Dialog Polish --- */
#CRMManagerDialog {
    background-color: #EFF1F5;
}
#CRMManagerDialog QLabel {
    font-size: 13px;
    color: #1A2035;
}

/* (Login Dialog rules are in Section 1.x above — no duplicates here) */

/* --- 22. Scrollbars --- */
QScrollBar:vertical {
    background: #F4F5F7;
    width: 10px;
    border: none;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #D1D5DB;
    min-height: 30px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #9CA3AF;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #F4F5F7;
    height: 10px;
    border: none;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background: #D1D5DB;
    min-width: 30px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background: #9CA3AF;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* --- 23. Tooltips --- */
QToolTip {
    background-color: #1A2035;
    color: #ffffff;
    border: none;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
}

/* --- 24. ComboBox (Global) --- */
QComboBox {
    border: 1px solid #E2E4E8;
    border-radius: 6px;
    padding: 5px 10px;
    background: #ffffff;
    color: #1A2035;
    font-size: 13px;
}
QComboBox:hover {
    border: 1px solid #0B9B8A;
}
QComboBox:focus {
    border: 1px solid #0B9B8A;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
    selection-background-color: #EBF5F5;
    selection-color: #1A2035;
    padding: 4px;
}

/* --- 25. Progress Bar --- */
QProgressBar {
    border: 1px solid #E2E4E8;
    border-radius: 6px;
    background-color: #F4F5F7;
    text-align: center;
    font-size: 12px;
    color: #1A2035;
    height: 20px;
}
QProgressBar::chunk {
    background-color: #0B9B8A;
    border-radius: 5px;
}

/* =====================================================
   EXTRACTED STYLES — Moved from inline Python
   ===================================================== */

/* --- 26. List Separator (company_login_ui.py) --- */
#ListSeparator {
    background-color: #E2E4E8;
}

/* (CompanyDisplayBtn rules consolidated in Section 2 above) */

/* --- 28. Full Catalog Components (full_catalog.py) --- */
#CatalogScrollArea {
    background-color: #E2E4E8;
}
#CatalogPageInput {
    font-size: 13px;
    font-weight: 600;
}
#CatalogTotalLabel {
    font-size: 13px;
    font-weight: 600;
    padding-left: 5px;
}
#CatalogReshuffleBtn {
    background-color: #8e44ad;
    color: white;
    font-weight: 600;
    border: none;
    border-radius: 8px;
}
#CatalogReshuffleBtn:hover {
    background-color: #9b59b6;
}
#CatalogReshuffleBtn:pressed {
    background-color: #7d3c98;
}
#CatalogReshuffleBtn:disabled {
    background-color: #D1D5DB;
    color: #9CA3AF;
}

/* --- 29. Final Data Side Panel (final_data.py) --- */
#SyncLabel {
    font-weight: 600;
    color: #6B7280;
    padding: 5px;
}
#ImgContainer {
    background-color: #ffffff;
    border: 1px solid #E2E4E8;
    border-radius: 8px;
}
#ImgTitle {
    font-weight: 600;
    color: #1A2035;
    border: none;
}
#ImgPreview {
    background-color: #FAFBFC;
    border: 1px solid #E2E4E8;
    border-radius: 6px;
}
#DupWarningLabel {
    color: #dc3545;
    font-weight: bold;
    font-size: 10px;
    background-color: #fff3cd;
    border: 1px solid #dc3545;
    border-radius: 4px;
    padding: 4px;
}
#SummaryFrame {
    background-color: #FAFBFC;
    border: 1px solid #E2E4E8;
    border-radius: 8px;
    padding: 10px;
}
#SummaryTitle {
    font-weight: 600;
    font-size: 12pt;
    color: #1A2035;
    border: none;
}
#SummaryLabel {
    font-weight: 500;
    color: #1A2035;
    border: none;
}
#SummaryValueGreen {
    font-weight: bold;
    color: #28a745;
    border: none;
}
#SummaryValueOrange {
    font-weight: bold;
    color: #fd7e14;
    border: none;
}
#SummaryValueRed {
    font-weight: bold;
    color: #dc3545;
    border: none;
}
#SummaryValueTeal {
    font-weight: bold;
    color: #0B9B8A;
    border: none;
}
#SummaryValuePurple {
    font-weight: bold;
    color: #6f42c1;
    border: none;
}
#SummaryValuePurple[alert="true"] {
    color: red;
    border: 1px solid red;
    padding: 2px;
}
#SummarySeparator {
    color: #E2E4E8;
    border: none;
}

/* --- 30. Cheque List (cheque_list.py) --- */
#BtnClearChq {
    background-color: #4CAF50;
    color: white;
    font-weight: bold;
}
#BtnClearChq[state="inactive"] {
    background-color: #f0f0f0;
    color: black;
    font-weight: normal;
}
#BtnClearChq[state="active"] {
    background-color: #4CAF50;
    color: white;
    font-weight: bold;
}
#ChqSummaryLabel {
    font-weight: 600;
    margin-right: 10px;
}
#BtnOrange {
    background-color: #f39c12;
    color: white;
}
#BtnOrange:hover {
    background-color: #e67e22;
}
#BtnBlue {
    background-color: #3498db;
    color: white;
}
#BtnBlue:hover {
    background-color: #2980b9;
}

/* --- 31. Reports (reports.py) --- */
#RefreshLabel {
    color: #ff9900;
    font-weight: bold;
    font-size: 14px;
}

/* --- 32. Settings User Management (settings.py) --- */
#BtnResetPw {
    background-color: #f39c12;
    color: white;
    border-radius: 3px;
    font-weight: bold;
    padding: 0 5px;
}
#BtnResetPw:hover {
    background-color: #e67e22;
}
#BtnDisableUser {
    background-color: #e74c3c;
    color: white;
    border-radius: 3px;
    font-weight: bold;
    padding: 0 5px;
}
#BtnDisableUser:hover {
    background-color: #c0392b;
}
#BtnEnableUser {
    background-color: #2ecc71;
    color: white;
    border-radius: 3px;
    font-weight: bold;
    padding: 0 5px;
}
#BtnEnableUser:hover {
    background-color: #27ae60;
}
#BtnDeleteUser {
    background-color: #34495e;
    color: white;
    border-radius: 3px;
    font-weight: bold;
    padding: 0 5px;
}
#BtnDeleteUser:hover {
    background-color: #2c3e50;
}
#DeniedLabel {
    color: #c0392b;
    font-weight: bold;
    padding: 20px;
}
#SettingsErrorLabel {
    color: red;
    font-weight: bold;
}

/* --- 33. PDF Preview Dialog (print_export.py) --- */
#PdfSidebarFrame {
    background-color: #2b2b2b;
    border-left: 1px solid #444;
}
#PdfPrintBtn {
    background-color: #28a745;
    color: white;
    padding: 10px;
    font-weight: bold;
    border-radius: 4px;
    font-size: 14px;
}
#PdfPrintBtn:hover {
    background-color: #218838;
}
#PdfCloseBtn {
    background-color: #dc3545;
    color: white;
    padding: 8px;
    font-weight: bold;
    border-radius: 4px;
}
#PdfCloseBtn:hover {
    background-color: #c82333;
}
#PdfZoomLabel {
    color: #888;
    font-size: 11px;
    font-weight: bold;
    margin-bottom: 5px;
}
#PdfZoomBtn {
    background-color: #444;
    color: white;
    padding: 6px;
    border-radius: 4px;
    text-align: left;
    padding-left: 10px;
}
#PdfZoomBtn:hover {
    background-color: #555;
}

/* --- 34. Group Test Tab (group_test_tab.py) --- */
#ProductCardRow {
    background-color: white;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    margin-bottom: 4px;
}
#ProductCardRow:hover {
    border: 1px solid #3498db;
    background-color: #f8fbff;
}
#ProductCardRow[alt="true"] {
    background-color: #f9f9f9;
    margin-bottom: 2px;
    margin-left: 20px;
}
#ProductCardRow[alt="true"]:hover {
    border: 1px solid #3498db;
    background-color: #eaf2f8;
}
#CardImgLabel {
    background-color: #f0f0f0;
    border: 1px solid #ddd;
}
#CardGroupLabel {
    color: #666;
    font-size: 10px;
}
#CardInfoLabel {
    color: #333;
    font-size: 11px;
}
#CardPageLabel {
    font-weight: bold;
    color: #2980b9;
}
#CardOrderLabel {
    color: #888;
    font-size: 10px;
}
#GroupTestScroll {
    background-color: #f5f5f5;
}
#GroupSectionHeader {
    background: #555;
    color: white;
    font-weight: bold;
    padding: 5px;
    margin-top: 10px;
}
#ClusterHeader {
    color: #2c3e50;
    font-weight: bold;
    font-style: italic;
    margin-top: 5px;
}

/* --- 35. Shared Button Variants --- */
#BtnApplyGreen {
    background-color: #28a745;
    color: white;
    font-weight: bold;
    border-radius: 4px;
    padding: 6px;
}
#BtnApplyGreen:hover {
    background-color: #218838;
}
#BtnCancelRed {
    background-color: #dc3545;
    color: white;
    font-weight: bold;
    border-radius: 4px;
    padding: 6px;
}
#BtnCancelRed:hover {
    background-color: #c82333;
}
