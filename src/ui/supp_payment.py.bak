        self.t_pur_tod.table.itemChanged.connect(lambda item: self.save_section("tp_pur_today", self.t_pur_tod, ["date", "particulars", "payment", "col4", "col5"]))
        self.t_pur_upc.table.itemChanged.connect(lambda item: self.save_section("tp_pur_upcoming", self.t_pur_upc, ["date", "particulars", "payment", "col4", "col5"]))
        self.t_acc.table.itemChanged.connect(lambda item: self.save_section("tp_accounts", self.t_acc, ["account_name", "remain_cash", "bank_cash"]))
        self.t_lim.table.itemChanged.connect(lambda item: self.save_section("tp_limits", self.t_lim, ["limit_type", "amount", "col3"]))
